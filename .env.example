# GeoMarketics - Environment Variables
# Copy this to .env.local and fill in values before deploying.

# Optional: App public URL (auto-set by Vercel)
# NEXT_PUBLIC_APP_URL=https://geomarketics.vercel.app

# Optional: Mapbox (not required, app uses Leaflet/OpenStreetMap)
# NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1...your_token

# Future: Supabase database connection
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
